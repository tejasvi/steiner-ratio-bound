import S43Core.Geom

/-! # The split lists (the text of data/d_regular.num and data/d_steiner.num, embedded verbatim; do not edit)
Each line of a `.num` file is one split, in the numeric form written by `splits2num.py` (in the repository's `checker/`):
`nS- e_1..e_k nS+ v_1..v_m nT* a_1 b_1 .. a_t b_t monomask` (edge ids: 0-based positions in the family's edge list,
edge 0 = (A,s) of length 1, edge i >= 1 has length = variable i-1; node ids as in `Ids`; monomask bit i = variable i is
monotone, as derived by mono43.py). The `.num` text is embedded verbatim and parsed by `parseSplits`. -/

namespace S43

def parseNats (s : String) : List Nat := (s.splitOn " ").filterMap (fun t => if t.isEmpty then none else t.toNat?)

/-- one split from its token list; `none` on malformed input -/
def parseSplit (xs : List Nat) : Option Split := do
  let (k, r) ← (match xs with | k :: r => some (k, r) | [] => none)
  let sm := r.take k; let r := r.drop k
  let (m, r) ← (match r with | m :: r => some (m, r) | [] => none)
  let sp := r.take m; let r := r.drop m
  let (t, r) ← (match r with | t :: r => some (t, r) | [] => none)
  let te := r.take (2 * t); let r := r.drop (2 * t)
  let mono ← r.head?
  if sm.length != k || sp.length != m || te.length != 2 * t || r.length != 1 then none
  let ta := (List.range t).map (fun i => te[2 * i]!); let tb := (List.range t).map (fun i => te[2 * i + 1]!)
  some ⟨sm.toArray, sp.toArray, ta.toArray, tb.toArray, mono⟩

def parseSplits (txt : String) : Array Split :=
  ((txt.splitOn "\n").filter (fun l => !(parseNats l).isEmpty)).toArray.map (fun l => (parseSplit (parseNats l)).getD default)

