/-! The case (st, fval 2) at rho = 2141/2500 from its skeleton and 11 shards (generated by
tools/gen_lean43c.py). -/

namespace S43Data.C2
open S43

-- hundreds of shards: the range list and the shard facts are deep terms
set_option maxRecDepth 100000

theorem mono : monoCheck .st 2 = true := by native_decide
theorem skelSome : (skelBoxes (S43.mkCase true 2) (Codes.ofString skel)).isSome = true := by native_decide
theorem skelN : skelSize (S43.mkCase true 2) (Codes.ofString skel) = 17542 := by native_decide

def ranges : List (ℕ × ℕ) := [(0, 1321), (1321, 1494), (2815, 1754), (4569, 1838), (6407, 1896), (8303, 1906), (10209, 2013), (12222, 1670), (13892, 1414), (15306, 1337), (16643, 899)]

theorem hcont : contig ranges 0 17542 = true := by decide

theorem hall : List.Forall (fun r : ℕ × ℕ => ∃ cs, shardOKPar (S43.mkCase true 2) (S43.DI.ofRat 2141 2500) (Codes.ofString skel) cs r.1 r.2 = true)
    ranges :=
  ⟨⟨_, S43Data.C2.ok00000⟩, ⟨_, S43Data.C2.ok00001⟩, ⟨_, S43Data.C2.ok00002⟩, ⟨_, S43Data.C2.ok00003⟩, ⟨_, S43Data.C2.ok00004⟩, ⟨_, S43Data.C2.ok00005⟩, ⟨_, S43Data.C2.ok00006⟩, ⟨_, S43Data.C2.ok00007⟩, ⟨_, S43Data.C2.ok00008⟩, ⟨_, S43Data.C2.ok00009⟩, ⟨_, S43Data.C2.ok00010⟩⟩

theorem rho_enc : (DI.ofRat 2141 2500).Enc (2141 / 2500) := by
  have := enc_ofRat 2141 (q := 2500) (by norm_num); push_cast at this; exact this

theorem case : CaseOK .st 2 (2141 / 2500) :=
  case_good (F := .st) (fval := 2) (by decide) rho_enc (by norm_num) (by norm_num) (monoData_of_check mono)
    (skel := Codes.ofString skel) ranges (by rw [show caseOf .st 2 = (S43.mkCase true 2) from rfl, skelN]; exact hcont)
    (fun r hr => List.forall_iff_forall_mem.mp hall r hr) skelSome

end S43Data.C2
