import S43.Sound.Case
import S43.Sound.Data
import S43Data.C1.Shard00000
import S43Data.C1.Shard00001
import S43Data.C1.Shard00002
import S43Data.C1.Shard00003
import S43Data.C1.Shard00004
import S43Data.C1.Shard00005

/-! The case (reg, fval 3) at rho = 2141/2500 from its skeleton and 6 shards (generated by
tools/gen_lean43c.py). -/

namespace S43Data.C1
open S43

-- hundreds of shards: the range list and the shard facts are deep terms
set_option maxRecDepth 100000

theorem mono : monoCheck .reg 3 = true := by native_decide
theorem skelSome : (skelBoxes (S43.mkCase false 3) (Codes.ofString skel)).isSome = true := by native_decide
theorem skelN : skelSize (S43.mkCase false 3) (Codes.ofString skel) = 12507 := by native_decide

def ranges : List (ℕ × ℕ) := [(0, 2248), (2248, 2488), (4736, 2330), (7066, 2638), (9704, 2351), (12055, 452)]

theorem hcont : contig ranges 0 12507 = true := by decide

theorem hall : List.Forall (fun r : ℕ × ℕ => ∃ cs, shardOKPar (S43.mkCase false 3) (S43.DI.ofRat 2141 2500) (Codes.ofString skel) cs r.1 r.2 = true)
    ranges :=
  ⟨⟨_, S43Data.C1.ok00000⟩, ⟨_, S43Data.C1.ok00001⟩, ⟨_, S43Data.C1.ok00002⟩, ⟨_, S43Data.C1.ok00003⟩, ⟨_, S43Data.C1.ok00004⟩, ⟨_, S43Data.C1.ok00005⟩⟩

theorem rho_enc : (DI.ofRat 2141 2500).Enc (2141 / 2500) := by
  have := enc_ofRat 2141 (q := 2500) (by norm_num); push_cast at this; exact this

theorem case : CaseOK .reg 3 (2141 / 2500) :=
  case_good (F := .reg) (fval := 3) (by decide) rho_enc (by norm_num) (by norm_num) (monoData_of_check mono)
    (skel := Codes.ofString skel) ranges (by rw [show caseOf .reg 3 = (S43.mkCase false 3) from rfl, skelN]; exact hcont)
    (fun r hr => List.forall_iff_forall_mem.mp hall r hr) skelSome

end S43Data.C1
