theorem rho_enc : (DI.ofRat 2141 2500).Enc (2141 / 2500) := by
  have := enc_ofRat 2141 (q := 2500) (by norm_num); push_cast at this; exact this

theorem case : CaseOK .reg 1 (2141 / 2500) :=
  case_good (F := .reg) (fval := 1) (by decide) rho_enc (by norm_num) (by norm_num) (monoData_of_check mono)
    (skel := Codes.ofString skel) ranges (by rw [show caseOf .reg 1 = (S43.mkCase false 1) from rfl, skelN]; exact hcont)
