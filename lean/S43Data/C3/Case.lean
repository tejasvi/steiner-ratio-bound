namespace S43Data.C3
open S43

-- hundreds of shards: the range list and the shard facts are deep terms
set_option maxRecDepth 100000

theorem mono : monoCheck .reg 1 = true := by native_decide
theorem skelSome : (skelBoxes (S43.mkCase false 1) (Codes.ofString skel)).isSome = true := by native_decide
theorem skelN : skelSize (S43.mkCase false 1) (Codes.ofString skel) = 102728 := by native_decide

def ranges : List (ℕ × ℕ) := [(0, 3936), (3936, 3406), (7342, 3007), (10349, 3204), (13553, 3303), (16856, 2869), (19725, 3052), (22777, 3198), (25975, 3294), (29269, 3185), (32454, 3250), (35704, 3445), (39149, 3599), (42748, 3851), (46599, 4122), (50721, 5011), (55732, 4868), (60600, 4670), (65270, 3359), (68629, 3263), (71892, 3446), (75338, 3519), (78857, 3882), (82739, 4183), (86922, 4929), (91851, 5013), (96864, 4666), (101530, 1198)]

theorem hcont : contig ranges 0 102728 = true := by decide

theorem hall : List.Forall (fun r : ℕ × ℕ => ∃ cs, shardOKPar (S43.mkCase false 1) (S43.DI.ofRat 2141 2500) (Codes.ofString skel) cs r.1 r.2 = true)
