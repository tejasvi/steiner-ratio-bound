import S43.Sound.Case
import S43.Sound.Data
import S43Pilot.CtlTamper.Shard00000
import S43Pilot.CtlTamper.Shard00001
import S43Pilot.CtlTamper.Shard00002
import S43Pilot.CtlTamper.Shard00003

/-! The case (reg, fval 3) at rho = 4/5 from its skeleton and 4 shards (generated by
tools/gen_lean43c.py). -/

namespace S43Pilot.CtlTamper
open S43

-- hundreds of shards: the range list and the shard facts are deep terms
set_option maxRecDepth 100000

theorem mono : monoCheck .reg 3 = true := by native_decide
theorem skelSome : (skelBoxes (S43.mkCase false 3) (Codes.ofString skel)).isSome = true := by native_decide
theorem skelN : skelSize (S43.mkCase false 3) (Codes.ofString skel) = 74 := by native_decide

def ranges : List (ℕ × ℕ) := [(0, 14), (14, 20), (34, 20), (54, 20)]

theorem hcont : contig ranges 0 74 = true := by decide

theorem hall : List.Forall (fun r : ℕ × ℕ => ∃ cs, shardOKPar (S43.mkCase false 3) (S43.DI.ofRat 4 5) (Codes.ofString skel) cs r.1 r.2 = true)
    ranges :=
  ⟨⟨_, S43Pilot.CtlTamper.ok00000⟩, ⟨_, S43Pilot.CtlTamper.ok00001⟩, ⟨_, S43Pilot.CtlTamper.ok00002⟩, ⟨_, S43Pilot.CtlTamper.ok00003⟩⟩

theorem rho_enc : (DI.ofRat 4 5).Enc (4 / 5) := by
  have := enc_ofRat 4 (q := 5) (by norm_num); push_cast at this; exact this

theorem case : CaseOK .reg 3 (4 / 5) :=
  case_good (F := .reg) (fval := 3) (by decide) rho_enc (by norm_num) (by norm_num) (monoData_of_check mono)
    (skel := Codes.ofString skel) ranges (by rw [show caseOf .reg 3 = (S43.mkCase false 3) from rfl, skelN]; exact hcont)
    (fun r hr => List.forall_iff_forall_mem.mp hall r hr) skelSome

end S43Pilot.CtlTamper
