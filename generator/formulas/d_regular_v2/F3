if((mono_mask & FMASK3) != 0) return INF;   // unbounded f allowed in F_VAL 3 (extension argument; PQ in S-)
ld L_s_minus = b + c + d + e + f + s + 1;
ld L_t = sqrt(b*b + b + 1);
ld L_s_plus;
if(F_VAL == 2) { if(!__f3_detail::steiner_cond(b, c, d, s, e)) return INF; else L_s_plus = __f3_detail::steiner_length(b, c, d, s, e); }
else {
#ifdef NET4_PREFILTER
{ double lbv = rho*L_t + __net4::L3lb(b, c, d, s, e, f) - L_s_minus; if(!(lbv < -eps)) return lbv; }
#endif
L_s_plus = __net4::L3(b, c, d, s, e, f); }
